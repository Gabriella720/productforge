# Analytics only (public/analytics.json) — separate from Data Backup session token.
# Fine-grained PAT with Contents: Read and write on this repo only.
#
# Local dev: set VITE_GITHUB_ANALYTICS_TOKEN below.
# Production: GitHub Actions secret ANALYTICS_GITHUB_TOKEN (cannot start with GITHUB_).
VITE_GITHUB_ANALYTICS_TOKEN=
VITE_GITHUB_ANALYTICS_OWNER=Gabriella720
VITE_GITHUB_ANALYTICS_REPO=productforge
VITE_GITHUB_ANALYTICS_BRANCH=main
VITE_GITHUB_ANALYTICS_PATH=public/analytics.json

# Optional: higher-quality blog auto-translation (LibreTranslate). Without these, Google Translate (gtx) is used.
# VITE_LIBRETRANSLATE_URL=https://libretranslate.com
# VITE_LIBRETRANSLATE_API_KEY=
